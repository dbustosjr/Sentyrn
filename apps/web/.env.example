# App URL (OAuth redirectTo target — your Next.js app, not InsForge host)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# InsForge (from `.insforge/project.json` oss_host + `npx @insforge/cli secrets get ANON_KEY`)
NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.us-west.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Server-only copy of anon key (preferred in server actions / route handlers)
INSFORGE_ANON_KEY=
